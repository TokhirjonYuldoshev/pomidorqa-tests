{
  "name": "pomidorqa-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Personal QA automation project for PomidorQA: Playwright, TypeScript, API, E2E, CI and stability checks",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "lint": "eslint src tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "typescript-eslint": "^8.67.0",
    "typescript": "^5.9.0"
  }
}
